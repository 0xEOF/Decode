# Copy this file to .env.local (Next.js convention) and fill in your key.
# Never commit .env.local. The key is read server-side only (in the
# app/api/scan-covert route handler, via @decode/ai) — it is never sent to
# the browser.
ANTHROPIC_API_KEY=

# Only needed if your key is a personal or service-account key that ISN'T
# scoped to one workspace (Claude Console -> Settings -> API keys). Such keys
# return a 400 "anthropic-workspace-id is required..." error without this.
# Find the ID under Settings -> Workspaces. Leave blank for a workspace-scoped
# key or a legacy workspace key — it doesn't need this.
ANTHROPIC_WORKSPACE_ID=

# Auth + database (see README.md "Database & Auth setup" for the full
# walkthrough). Leave all three blank to run without accounts at all — every
# page still works anonymously with mock data; you only lose real sign-up/
# sign-in and persistence until these are set.
#
# Supabase project -> Settings -> API. Safe to expose to the browser (that's
# what NEXT_PUBLIC_ means here) — Postgres Row-Level Security, not secrecy of
# this key, is what actually protects user data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase project -> Settings -> Database -> Connection string -> "Transaction"
# pooler mode (port 6543) — the app talks to Postgres directly via Drizzle,
# not through Supabase's client library, so it needs the pooled connection
# string, not the anon key above.
DATABASE_URL=
